# ROS 2 Jazzy sources for the UR5e Isaac Sim demo.
# Universal_Robots_ROS2_MoveIt_Config is no longer a separate repository.
# ur_moveit_config lives in Universal_Robots_ROS2_Driver. This workspace
# keeps a sparse checkout of that package only.
repositories:
  Universal_Robots_ROS2_Description:
    type: git
    url: https://github.com/UniversalRobots/Universal_Robots_ROS2_Description.git
    version: jazzy
  Universal_Robots_ROS2_Driver:
    type: git
    url: https://github.com/UniversalRobots/Universal_Robots_ROS2_Driver.git
    version: jazzy
  topic_based_ros2_control:
    type: git
    url: https://github.com/PickNikRobotics/topic_based_ros2_control.git
    version: main
